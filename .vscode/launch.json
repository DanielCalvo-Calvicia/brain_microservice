
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug (debug env)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/windows/Scripts/python.exe",
            "env": {
                "APP_ENV": "debug"
            },
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Run (production env)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/windows/Scripts/python.exe",
            "env": {
                "APP_ENV": "production"
            },
            "envFile": "${workspaceFolder}/.env.production"
        }
    ]
}
