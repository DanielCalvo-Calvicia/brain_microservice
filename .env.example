# Runtime environment: development, staging, or production.
# Legacy aliases accepted by the app: debug -> development, dev -> development, prod -> production.
APP_ENV=development
VSCODE_ENV=
VSCODE_LAUNCH_PROFILE=

SERVICE_HOST=127.0.0.1
SERVICE_PORT=7999

PROVIDER_NAME=local
PROVIDER_TIMEOUT_SECONDS=30

MICROPHONE_BASE_URL=http://127.0.0.1:8000
MICROPHONE_STREAM_ENDPOINT=/stream
MICROPHONE_START_ENDPOINT=/start
MICROPHONE_STOP_ENDPOINT=/stop

STT_BASE_URL=http://127.0.0.1:8001
STT_SET_STREAM_ENDPOINT=/process/stream/set
STT_GET_STREAM_ENDPOINT=/process/stream/get
STT_BATCH_ENDPOINT=/process/batch

TTS_BASE_URL=http://127.0.0.1:8002
TTS_SET_STREAM_ENDPOINT=/process/stream/set
TTS_STREAM_ENDPOINT=/process/stream/get

SPEAKER_BASE_URL=http://127.0.0.1:8003
SPEAKER_PLAY_STREAM_ENDPOINT=/process/stream/set
# Deprecated fallback still supported when SPEAKER_PLAY_STREAM_ENDPOINT is unset.
SPEAKER_STREAM_ENDPOINT=

# ai-agent hosts several flows (agents), each with its own routes /<flow>/session/{start,message,end} and its own
# session. For every utterance Brain asks them ONE AFTER THE OTHER, in this order, each only when the one before
# has ended: conversation-flow writes the reply, motion-flow (last) decides the arm movements. A flow that asks
# the user a question stops the chain and gets the next utterance, which is the answer. Known flows:
# conversation-flow, motion-flow (a new flow needs its adapter in Brain, see infrastructure/outbound/http/ai_agent).
# ai-agent is not a mandatory preflight dependency: if it is down Brain starts and apologises aloud. A session per
# flow is attempted at startup on a best-effort basis and established lazily otherwise.
AI_AGENT_BASE_URL=http://127.0.0.1:7998
AI_AGENT_FLOWS=conversation-flow,motion-flow

# What Brain says while the flows work, so the user is never left in silence: PROGRESS_RECEIVED_MESSAGE at once
# when an utterance arrives from STT, PROGRESS_THINKING_MESSAGE every PROGRESS_THINKING_INTERVAL_SECONDS while the
# flows run (the first one after one interval, so a quick answer stays quiet). Only when all the flows have ended
# does Brain say the answer and send the movements to the stepper. An empty text says nothing; an interval of 0
# turns the thinking messages off.
PROGRESS_RECEIVED_MESSAGE=Message received.
PROGRESS_THINKING_MESSAGE=Thinking.
PROGRESS_THINKING_INTERVAL_SECONDS=2

# Brain moves the arms when motion-flow decides a movement sequence (best effort: a stepper failure never
# silences the reply, and a failed movement stops the rest of its sequence). ai-agent only says "left"/"right";
# these map that to the stepper_id stepper itself is configured with (its own STEPPER_CONFIGS). Only Brain
# talks to the stepper.
STEPPER_BASE_URL=http://127.0.0.1:8005
STEPPER_ROTATE_ENDPOINT_TEMPLATE=/control/{stepper_id}/rotate
STEPPER_LEFT_ARM_STEPPER_ID=stepper_1
STEPPER_RIGHT_ARM_STEPPER_ID=stepper_2
STEPPER_DEFAULT_RPM=15

STARTUP_PREFLIGHT_ENABLED=true
STARTUP_PREFLIGHT_TIMEOUT_SECONDS=60
MICROSERVICE_READY_POLL_INTERVAL_SECONDS=2

# Live integration tests are skipped unless this is set to 1.
RUN_LIVE_MICROSERVICE_TESTS=0

# Wake phrase: with it on, the robot answers only an utterance in which the phrase is heard (anywhere in the
# sentence; the code may be said in digits or words: "306", "three oh six"). A local engine inside the STT service
# (the gate, see STT_GATE_ENABLED in stt_microservice/.env.example) listens to everything for free; only the
# audio of an utterance with the phrase goes on to the real STT. The phrase alone is answered with
# WAKE_ACK_MESSAGE and the next sentence is taken without the phrase, once, if it comes within
# WAKE_FOLLOWUP_SECONDS (0 = off). WAKE_NAME_SIMILARITY (0 to 1) is how like the name a misheard word may be.
# STT_GATE_PATH_PREFIX is where the gate's routes are in the STT service. Needs STT_GATE_ENABLED=1 there.
WAKE_PHRASE_ENABLED=0
WAKE_PHRASE=Oblivion 306
WAKE_NAME_SIMILARITY=0.75
WAKE_FOLLOWUP_SECONDS=15
WAKE_ACK_MESSAGE=Yes?
STT_GATE_PATH_PREFIX=/gate
